# Normalize line endings so a Windows working tree (core.autocrlf) cannot
# pollute diffs or byte-level fixtures.
* text=auto eol=lf
*.ipynb text eol=lf
*.svg text eol=lf
# Vendored KaTeX chunk: generated by scripts/build-katex-chunk.mjs and kept out
# of language statistics and review diffs.
client.katex.js text eol=lf linguist-vendored linguist-generated
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
