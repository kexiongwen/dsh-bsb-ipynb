{
  "name": "dsh-bsb-ipynb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "description": "Preview and run Jupyter notebooks (.ipynb) in the DSH better-sidebar file tree.",
  "license": "MIT",
  "author": "kexiongwen (https://github.com/kexiongwen)",
  "homepage": "https://github.com/kexiongwen/dsh-bsb-ipynb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kexiongwen/dsh-bsb-ipynb.git"
  },
  "bugs": {
    "url": "https://github.com/kexiongwen/dsh-bsb-ipynb/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "jupyter",
    "notebook",
    "ipynb",
    "better-sidebar",
    "deepseek-harness"
  ],
  "scripts": {
    "test": "node --test --test-timeout=180000 test/*.test.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./python/bridge.py": "./python/bridge.py",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "python/bridge.py",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README_ZH.md",
    "docs/screenshot.png",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
